import clsx from 'clsx'
import { useCallback, useEffect, useRef, useState } from 'react'
import { useCanvasContext, usePDFContext } from './pdfState'
import { PDFManagerProps, TOOLBAR_HEIGHT } from './utils'

interface PageSizesType {
	basePageWidth: number
	basePageHeight: number
	canvasDisplayWidth: number
	canvasDisplayHeight: number
}

// Buffer zone past the page edge — shows the background briefly
// before navigating, so the user sees a visual "page gap"
const PAGE_GAP_BUFFER = 60

export default function PDFCanvas({ manager, canvas }: PDFManagerProps) {
	const { state, setScale, setCurrentPage } = usePDFContext()
	const { canvasState, setPanelOffset, setIsInitialized } = useCanvasContext()
	const { currentPage, scale, rotation, document, isLoading } = state
	const containerDiv = useRef<HTMLDivElement>(null)
	const contentWrapperDiv = useRef<HTMLDivElement>(null)
	const [, setPageSizes] = useState<PageSizesType>({
		basePageWidth: 0,
		basePageHeight: 0,
		canvasDisplayWidth: 0,
		canvasDisplayHeight: 0,
	})

	// =========================== Function definition ===============================

	const nextPage = useCallback(() => {
		setCurrentPage(state.currentPage + 1)
	}, [])

	const previousPage = useCallback(() => {
		setCurrentPage(state.currentPage - 1)
	}, [])

	const scrollByDelta = useCallback((delta: number) => {
		if (!canvas.current || !containerDiv.current) return

		console.debug('=== scrollByDelta Debug ===')
		console.debug(
			'canvas.current.style.height:',
			canvas.current.style.height,
		)
		console.debug('canvas.current.height:', canvas.current.height)
		console.debug(
			'canvas.current.offsetHeight:',
			canvas.current.offsetHeight,
		)
		console.debug(
			'canvas.current.clientHeight:',
			canvas.current.clientHeight,
		)
		console.debug(
			'containerDiv.current.clientHeight:',
			containerDiv.current.clientHeight,
		)

		let canvasHeight = parseFloat(canvas.current.style.height) || 0
		let viewportHeight = containerDiv.current.clientHeight
		// overflow is not calculate correctly.
		let overflow = canvasHeight - viewportHeight

		console.debug(`Scroll by delta: ${delta}`)
		console.debug(`Overflow: ${overflow}`)

		if (overflow > 0) {
			let scrollAmount = Math.min(Math.abs(delta), 100)
			let maxPanUp = overflow / 2 + PAGE_GAP_BUFFER
			let maxPanDown = -(overflow / 2) - PAGE_GAP_BUFFER

			if (delta >= 0) {
				// Down
				if (canvasState.panelOffsetY > maxPanDown) {
					setPanelOffset(
						canvasState.panelOffsetX,
						Math.max(
							canvasState.panelOffsetY - scrollAmount,
							maxPanDown,
						),
					)
				} else {
					if (state.currentPage < state.totalPages) {
						setPanelOffset(0, maxPanUp - PAGE_GAP_BUFFER) // ?
						setCurrentPage(state.currentPage + 1)
					}
				}
			} else {
				if (canvasState.panelOffsetY < maxPanUp) {
					setPanelOffset(
						canvasState.panelOffsetX,
						Math.min(
							canvasState.panelOffsetY + scrollAmount,
							maxPanUp,
						),
					)
				} else {
					if (state.currentPage > 1) {
						setPanelOffset(0, maxPanDown - PAGE_GAP_BUFFER)
						setCurrentPage(state.currentPage - 1)
					}
				}
			}
		} else {
			// Change page
			if (delta >= 0) {
				nextPage()
			} else {
				previousPage()
			}
		}
	}, [])

	// TODO: Fix the bug when wheeling to fast, PDF not showing correctly.
	const handleWheel = useCallback((event: WheelEvent) => {
		if (!canvas.current || !containerDiv.current) return
		if (!containerDiv.current?.contains(event.target as Node)) return

		// Zoom in/out
		// TODO: To be implemented
		if (event.ctrlKey) {
			return
		}

		event.preventDefault()

		// Normalize deltaY to pixels across browsers.
		// Firefox reports deltaMode=1 (lines), most others report deltaMode=0 (pixels).
		const LINE_HEIGHT = 16
		let pixelDelta = event.deltaY
		if (event.deltaMode === 1) pixelDelta *= LINE_HEIGHT
		else if (event.deltaMode === 2)
			pixelDelta *= containerDiv.current.clientHeight

		scrollByDelta(pixelDelta)
	}, [])

	// ===============================================================================

	// Calculate the proper scale BEFORE first render to avoid position jumps
	useEffect(() => {
		if (!canvas.current) return
		if (!document) return
		if (canvasState.isInitialized) return
		if (isLoading) return

		// Reset pan offset to center the PDF
		setPanelOffset(0, 0)

		// Auto-fit to page on first load for better initial view of both portrait and landscape
		if (containerDiv.current) {
			const container = containerDiv.current
			document.getPage(1).then((page) => {
				let viewport = page.getViewport({
					scale: 1,
					rotation: state.rotation,
				})
				let containerHeight = container.clientHeight - TOOLBAR_HEIGHT
				let containerWidth = container.clientWidth - 40

				let fitHeightScale = containerHeight / viewport.height
				let fitWidthScale = containerWidth / viewport.width
				let fitPageScale = Math.min(fitHeightScale, fitWidthScale)

				let scaledViewport = page.getViewport({
					scale: fitPageScale,
					rotation: state.rotation,
				})

				const baseViewport = page.getViewport({ scale: 1, rotation: 0 })
				setPageSizes({
					basePageWidth: baseViewport.width,
					basePageHeight: baseViewport.height,
					canvasDisplayWidth: scaledViewport.width,
					canvasDisplayHeight: scaledViewport.height,
				})

				console.log('Canvas Initialized.')

				setScale(fitPageScale)
			})
		}

		setIsInitialized(true)
	}, [document])

	useEffect(() => {
		if (!canvas.current) return
		if (!document) return
		if (!canvasState.isInitialized) return

		const canvasObject = canvas.current
		let outputScale = 1
		document.getPage(currentPage).then((page) => {
			let viewport = page.getViewport({ scale, rotation })
			outputScale = window.devicePixelRatio || 1

			// Set canvas dimensions to match the scaled viewport and device pixel ratio for crisp rendering
			canvasObject.width = Math.floor(viewport.width * outputScale)
			canvasObject.height = Math.floor(viewport.height * outputScale)
			canvasObject.style.width = `${viewport.width}px`
			canvasObject.style.height = `${viewport.height}px`

			let context = canvasObject.getContext('2d')
			if (context) context.scale(outputScale, outputScale)
		})

		let cancelled = false

		async function render() {
			try {
				await manager.renderPage(currentPage, {
					canvas: canvas.current!,
					scale: scale * outputScale,
					rotation,
				})
			} catch (err) {
				if (!cancelled) {
					console.error(err)
				}
			}
		}

		render()

		return () => {
			cancelled = true
		}
	}, [currentPage, scale, rotation, document])

	useEffect(() => {
		window.addEventListener('wheel', handleWheel, { passive: false })

		return () => {
			window.removeEventListener('wheel', handleWheel)
		}
	}, [])

	let divBlock
	if (state.isLoading) {
		divBlock = (
			<div className="absolute inset-0 flex items-center justify-center">
				<div className="animate-spin rounded-full h-12 w-12 border-4 border-sage border-t-transparent"></div>
				<span className="ml-3 text-charcoal dark:text-gray-200 font-medium">
					Opening your PDF...
				</span>
			</div>
		)
	} else if (state.document && state.totalPages > 0) {
		divBlock = (
			<div className="absolute bottom-4 left-1/2 transform -translate-x-1/2 floating-panel">
				<div className="flex items-center space-x-2 text-sm text-charcoal dark:text-gray-200">
					<span>Page</span>
					<span className="font-semibold">{state.currentPage}</span>
					<span>of</span>
					<span className="font-semibold">{state.totalPages}</span>
					<span className="mx-2">•</span>
					<span>{Math.round(state.scale * 100)}%</span>
				</div>
			</div>
		)
	} else {
		divBlock = (
			<div className="absolute inset-0 flex items-center justify-center">
				{/* {#if !presentationMode}
				<div class="text-center">
					<div class="text-6xl mb-4">📄</div>
					<h3 class="text-xl font-medium text-charcoal mb-2">Drop a PDF here or click to browse</h3>
				</div>
			{/if} */}
			</div>
		)
	}

	return (
		// <>
		// 	{state.isLoading && (
		// 		<div className="loading-overlay">
		// 			<div className="loading-spinner"></div>
		// 			<p>加载中...</p>
		// 		</div>
		// 	)}

		// 	<div className="pdf-render-container">
		// 		<canvas ref={canvas} className="pdf-canvas" />
		// 	</div>
		// </>
		<div
			ref={containerDiv}
			className="pdf-viewer relative w-full h-full overflow-hidden"
		>
			<div
				ref={contentWrapperDiv}
				className="flex items-center justify-center w-full h-full"
				style={{
					transform: `translate(${canvasState.panelOffsetX}px, ${canvasState.panelOffsetY}px)`,
				}}
			>
				<div className="relative">
					<canvas
						ref={canvas}
						className={clsx(
							'shadow-lg pdf-canvas',
							!state.document && 'hidden',
						)}
					/>
					{/* <canvas
				bind:this={pdfCanvas}
				className="shadow-lg"
				// class:rounded-lg={!presentationMode}
				class:hidden={!$pdfState.document}
				style="z-index: 1;"
			></canvas> */}

					{/* <canvas
				bind:this={drawingCanvas}
				className="absolute top-0 left-0 drawing-canvas"
				class:rounded-lg={!presentationMode}
				class:eraser={$drawingState.tool === 'eraser'}
				class:hidden={!$pdfState.document}
				style="z-index: 2;"
			></canvas> */}

					{/* {#if $pdfState.document && canvasDisplayWidth > 0 && canvasDisplayHeight > 0}
				<TextOverlay
					canvasWidth={canvasDisplayWidth}
					canvasHeight={canvasDisplayHeight}
					currentScale={$pdfState.scale}
					{viewOnlyMode}
					rotation={$pdfState.rotation}
					{basePageWidth}
					{basePageHeight}
				/>
			{/if} */}

					{/* {#if $pdfState.document && canvasDisplayWidth > 0 && canvasDisplayHeight > 0}
				<StickyNoteOverlay
					containerWidth={canvasDisplayWidth}
					containerHeight={canvasDisplayHeight}
					scale={$pdfState.scale}
					{viewOnlyMode}
					rotation={$pdfState.rotation}
					{basePageWidth}
					{basePageHeight}
				/>
			{/if} */}

					{/* {#if $pdfState.document && canvasDisplayWidth > 0 && canvasDisplayHeight > 0}
				<StampOverlay
					containerWidth={canvasDisplayWidth}
					containerHeight={canvasDisplayHeight}
					scale={$pdfState.scale}
					{viewOnlyMode}
					rotation={$pdfState.rotation}
					{basePageWidth}
					{basePageHeight}
				/>
			{/if} */}

					{/* {#if $pdfState.document && canvasDisplayWidth > 0 && canvasDisplayHeight > 0}
				<ArrowOverlay
					containerWidth={canvasDisplayWidth}
					containerHeight={canvasDisplayHeight}
					scale={$pdfState.scale}
					{viewOnlyMode}
					rotation={$pdfState.rotation}
					{basePageWidth}
					{basePageHeight}
				/>
			{/if} */}

					{/* {#if $pdfState.document && canvasDisplayWidth > 0 && canvasDisplayHeight > 0 && pageLinks.length > 0}
				<LinkOverlay
					links={pageLinks}
					containerWidth={canvasDisplayWidth}
					containerHeight={canvasDisplayHeight}
					onGoToPage={goToPage}
				/>
			{/if} */}
				</div>
			</div>

			{/* <GestureHint /> */}

			{/* {#if $drawingState.tool === 'select' && $pdfState.document}
		<TextSelectionOverlay
			extractedText={extractedPageText}
			currentPage={$pdfState.currentPage}
			isLoading={isExtractingText}
			containerHeight={overlayHeight}
		/>
	{/if} */}

			{divBlock}
		</div>
	)
}
